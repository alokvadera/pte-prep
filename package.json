{
  "name": "pte-prep",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "tsc -b && vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "assets": "node scripts/gen-assets.mjs",
    "d1:migrate": "wrangler d1 migrations apply DB",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "pages:dev": "wrangler pages dev dist --d1=DB=pte-prep-db-local",
    "serve": "node scripts/serve.mjs 5200 dist",
    "preview": "node scripts/serve.mjs 5200 dist",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "tsx scripts/smoke.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "motion:review": "node scripts/motion-review.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:bank && npm run test:boundary && npm run contrast && npm run seo:audit",
    "verify:full": "npm run verify && npm run build && npm run seo:audit && (node scripts/serve.mjs 5200 dist & sleep 3; node scripts/browser-check.mjs http://localhost:5200; node scripts/seo-audit-browser.mjs http://localhost:5200; node scripts/motion-review.mjs http://localhost:5200; node scripts/contrast-render.mjs http://localhost:5200; node scripts/dark-audit.mjs http://localhost:5200; kill %1)",
    "contrast": "node scripts/contrast.mjs",
    "contrast:dark": "node scripts/dark-audit.mjs",
    "contrast:render": "node scripts/contrast-render.mjs",
    "plates": "node scripts/render-plates.mjs",
    "seo:audit": "node scripts/seo-audit.mjs dist",
    "seo:audit:browser": "node scripts/seo-audit-browser.mjs",
    "test:boundary": "tsx --tsconfig tsconfig.scripts.json scripts/ui-states-check.tsx",
    "test:bank": "tsx --tsconfig tsconfig.scripts.json scripts/bank-check.ts",
    "test:answers": "tsx tests/answers-and-results/run-evaluation.ts && tsx tests/answers-and-results/boundary-and-gating.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.147.0"
  },
  "description": "Free, unlimited PTE Academic mock tests. Runs entirely in the browser."
}
