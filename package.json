{
  "name": "pte-prep",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "tsc -b && vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "assets": "node scripts/gen-assets.mjs",
    "d1:migrate": "wrangler d1 migrations apply DB",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "pages:dev": "wrangler pages dev dist",
    "serve": "node scripts/serve.mjs 5200 dist",
    "preview": "node scripts/serve.mjs 5200 dist",
    "serve:audio": "node scripts/serve.mjs 5200 public",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:boundary": "node --import tsx tests/answers-and-results/boundary-and-gating.ts",
    "test:answers": "node --import tsx tests/answers-and-results/run-evaluation.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:audio": "node scripts/audio-playback-check.mjs",
    "motion:review": "node scripts/motion-review.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:smoke && npm run test:bank && npm run test:boundary && npm run test:answers && npm run test:coverage && npm run contrast && npm run build && npm run seo:audit",
    "verify:full": "npm run verify && (node scripts/serve.mjs 5200 dist & SERVER_PID=$!; sleep 3; STATUS=0; node scripts/browser-check.mjs http://localhost:5200 || STATUS=$?; node scripts/audio-playback-check.mjs http://localhost:5200 || STATUS=$?; node scripts/seo-audit-browser.mjs http://localhost:5200 || STATUS=$?; node scripts/motion-review.mjs http://localhost:5200 || STATUS=$?; node scripts/contrast-render.mjs http://localhost:5200 || STATUS=$?; node scripts/dark-audit.mjs http://localhost:5200 || STATUS=$?; kill $SERVER_PID 2>/dev/null || true; exit $STATUS)",
    "contrast": "node scripts/contrast.mjs",
    "contrast:dark": "node scripts/dark-audit.mjs",
    "contrast:render": "node scripts/contrast-render.mjs",
    "plates": "node scripts/render-plates.mjs",
    "seo:audit": "node scripts/seo-audit.mjs dist",
    "seo:audit:browser": "node scripts/seo-audit-browser.mjs",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:pages": "vitest run tests/pages",
    "test:functions": "vitest run tests/functions",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:bank": "tsx scripts/bank-check.ts",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.147.0"
  },
  "description": "Free, unlimited PTE Academic mock tests. Runs entirely in the browser."
}
