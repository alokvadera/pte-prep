# Absolute origin of the deployed site.
#
# VITE_SITE_ORIGIN is read by src/seo/site.ts at runtime (Vite only exposes
# VITE_-prefixed vars to client code) and by scripts/prerender.mjs at build time,
# which also accepts plain SITE_ORIGIN. Set both for clarity.
# It is what makes <link rel="canonical"> and sitemap.xml absolute, which search
# engines prefer. Replace it with your real domain — every other file picks it up
# without further changes.
#
# If it is unset, prerendering uses https://pte-prep.pages.dev as the canonical
# origin. Set SITE_ORIGIN to the host-only origin when deploying elsewhere;
# configure BASE_PATH separately for deployments under a sub-path.
SITE_ORIGIN=https://pte-prep.pages.dev
VITE_SITE_ORIGIN=https://pte-prep.pages.dev

# Brevo transactional email configuration (optional, for password resets)
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME=PTE Prep

# Fish Audio TTS API Key (optional, for regenerating offline audio assets)
# FISHAUDIO_API_KEY=sk-fish-...
